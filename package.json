{
  "name": "wird",
  "version": "1.61",
  "description": "**Open Source, Offline-First Islamic Adhkar**",
  "main": "index.js",
  "scripts": {
    "dev": "npm run build:css && npx serve www",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "build:css": "tailwindcss -i ./www/input.css -o ./www/compiled.css --minify",
    "watch:css": "tailwindcss -i ./www/input.css -o ./www/compiled.css --watch",
    "android:sync:win": "npm run build:css && npx cap sync android && node scripts/sync-android-win.mjs",
    "android:open:win": "npm run build:css && npx cap sync android && node scripts/sync-android-win.mjs --open"
  },
  "keywords": [],
  "author": "",
  "license": "Polyform-Noncommercial-1.0.0",
  "type": "commonjs",
  "dependencies": {
    "@capacitor/android": "^8.0.1",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/cli": "^8.0.1",
    "@capacitor/core": "^8.0.1",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "8.0.1",
    "@capacitor/status-bar": "^8.0.0",
    "@tailwindcss/cli": "^4.1.18"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@playwright/test": "1.58.2",
    "serve": "13.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-waqf/wird.git"
  },
  "bugs": {
    "url": "https://github.com/open-waqf/wird/issues"
  },
  "homepage": "https://github.com/open-waqf/wird#readme"
}
