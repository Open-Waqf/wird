{
  "name": "wird",
  "version": "1.74",
  "description": "**Open Source, Offline-First Islamic Adhkar**",
  "main": "index.js",
  "scripts": {
    "build": "npm run build:js && npm run build:css && npm run build:sw",
    "dev": "npm run build && npx serve www",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "build:css": "tailwindcss -i ./www/input.css -o ./www/compiled.css --minify",
    "watch:css": "tailwindcss -i ./www/input.css -o ./www/compiled.css --watch",
    "build:js": "node scripts/build-js.js",
    "watch:js": "node scripts/build-js.js --watch",
    "build:sw": "node scripts/build-sw.js",
    "android:run": "node scripts/run-android.mjs",
    "android:live": "node scripts/run-android.mjs --live",
    "android:release": "node scripts/release-android.mjs",
    "release": "node scripts/release.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "Polyform-Noncommercial-1.0.0",
  "type": "commonjs",
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@tailwindcss/cli": "^4.1.18"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@playwright/test": "1.64.0",
    "esbuild": "^0.28.2",
    "serve": "14.2.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-waqf/wird.git"
  },
  "bugs": {
    "url": "https://github.com/open-waqf/wird/issues"
  },
  "homepage": "https://github.com/open-waqf/wird#readme"
}
