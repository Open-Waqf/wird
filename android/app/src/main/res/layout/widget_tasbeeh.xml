<?xml version="1.0" encoding="utf-8"?>
<!-- Tasbeeh widget, 4x2 and 2x2: arrows + step dots, the dhikr, the count, a thin bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tasbeeh_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_tasbeeh_bg"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingTop="10dp"
    android:paddingRight="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layoutDirection="ltr"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tasbeeh_prev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_tasbeeh_arrow"
            android:contentDescription="@string/tasbeeh_prev"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tasbeeh_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="✓"
                android:textColor="#FDE68A"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/tasbeeh_dots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView android:id="@+id/tasbeeh_dot1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:paddingLeft="2dp" android:paddingRight="2dp" android:text="●" android:textSize="8sp" />
                <TextView android:id="@+id/tasbeeh_dot2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:paddingLeft="2dp" android:paddingRight="2dp" android:text="●" android:textSize="8sp" />
                <TextView android:id="@+id/tasbeeh_dot3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:paddingLeft="2dp" android:paddingRight="2dp" android:text="●" android:textSize="8sp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tasbeeh_next"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_tasbeeh_arrow"
            android:contentDescription="@string/tasbeeh_next"
            android:gravity="center"
            android:text="›"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tasbeeh_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center"
        android:lineSpacingMultiplier="1.1"
        android:maxLines="3"
        android:text="سُبْحَانَ اللهِ"
        android:textColor="#ECFDF5"
        android:textDirection="rtl"
        android:textSize="22sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center|bottom"
        android:layoutDirection="ltr"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tasbeeh_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tasbeeh_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text=" / 33"
            android:textColor="#B36EE7B7"
            android:textSize="13sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/tasbeeh_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginLeft="-12dp"
        android:layout_marginRight="-12dp"
        android:max="33"
        android:progress="0"
        android:progressDrawable="@drawable/widget_tasbeeh_progress" />

    <ProgressBar
        android:id="@+id/tasbeeh_bar_done"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginLeft="-12dp"
        android:layout_marginRight="-12dp"
        android:max="1"
        android:progress="1"
        android:progressDrawable="@drawable/widget_tasbeeh_progress_done"
        android:visibility="gone" />
</LinearLayout>
